# Copy to server/.env (gitignored) and fill in. Real environment variables
# always win over this file, which is only read when it exists.

# Session cookie signing. Any long random string.
BEXT_SESSION_SECRET=

# Encrypts the AI provider API keys stored per user. Any long random string, or
# 64 hex characters. Changing it means every saved provider key has to be
# entered again — it never loses anything else.
BEXT_AI_KEY_SECRET=

# Offers the free Google Gemini engine, on a key this server supplies. Leave it
# unset and that engine simply is not offered.
BEXT_GEMINI_FREE_KEY=
